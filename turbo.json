{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "VEYLEN_HOME",
    "VEYLEN_DESKTOP_WS_URL",
    "VEYLEN_BROWSER_HOST_PIPE_PATH",
    "VEYLEN_BROWSER_USE_PIPE_PATH",
    "VEYLEN_BROWSER_PERF",
    "VEYLEN_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "VEYLEN_GROK_ACP_DEBUG",
    "VEYLEN_WEB_SOURCEMAP",
    "VEYLEN_SERVER_SOURCEMAP",
    "VEYLEN_DESKTOP_SOURCEMAP",
    "VEYLEN_MODE",
    "VEYLEN_PORT",
    "VEYLEN_NO_BROWSER",
    "VEYLEN_AUTH_TOKEN",
    "VEYLEN_PUBLIC_URL",
    "VEYLEN_ALLOW_INSECURE_REMOTE",
    "VEYLEN_LOG_WS_EVENTS",
    "VEYLEN_HOST",
    "VEYLEN_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
